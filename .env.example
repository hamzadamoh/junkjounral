# Copy this file to .env.local and fill in your values.
# Never commit .env or .env.local (they are gitignored).
# NEVER put real API keys or passwords in this file—use empty placeholders only.

# ---------------------------------------------------------------------------
# App (optional)
# ---------------------------------------------------------------------------
# Password to access the app. If unset, app allows access without password.
# VITE_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Google Drive (Account 1)
# ---------------------------------------------------------------------------
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_CLIENT_SECRET=
VITE_GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ---------------------------------------------------------------------------
# Google Drive (Account 2, optional)
# ---------------------------------------------------------------------------
VITE_GOOGLE_DRIVE_2_CLIENT_ID=
VITE_GOOGLE_DRIVE_2_CLIENT_SECRET=
VITE_GOOGLE_DRIVE_2_REFRESH_TOKEN=
# VITE_GOOGLE_DRIVE_2_PARENT_FOLDER_ID=  (falls back to GOOGLE_DRIVE_PARENT_FOLDER_ID)

# ---------------------------------------------------------------------------
# Dropbox
# ---------------------------------------------------------------------------
VITE_DROPBOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# OpenAI (for ChatGPT prompts / prompt generation)
# ---------------------------------------------------------------------------
VITE_OPENAI_API_KEY=
# Server-side / Vercel can use:
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# TTAPI (Midjourney / Discord)
# ---------------------------------------------------------------------------
VITE_TTAPI_DOMAIN=
VITE_TTAPI_API_KEY=
# Optional: Discord (used by ttapiService / gateway)
# VITE_DISCORD_TOKEN=
# VITE_DISCORD_CHANNEL_ID=

# ---------------------------------------------------------------------------
# WordPress (image hosting / uploads)
# Use VITE_WP_URL or VITE_WORDPRESS_API_URL for the site URL (e.g. https://yoursite.com)
# ---------------------------------------------------------------------------
VITE_WP_URL=
# VITE_WORDPRESS_API_URL=   (alternative to VITE_WP_URL)
VITE_WP_USERNAME=
VITE_WP_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Etsy
# ---------------------------------------------------------------------------
VITE_ETSY_API_KEY=

# ---------------------------------------------------------------------------
# Optional: Replicate, OpenRouter, Hugging Face (for other AI models)
# ---------------------------------------------------------------------------
# VITE_REPLICATE_API_KEY=
# VITE_OPENROUTER_API_KEY=
# VITE_HUGGINGFACE_API_KEY=
